#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Aleph1-9012

set -Eeuo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -f $SCRIPT_DIR/../share/evangelion/bin/install.sh ]]; then
    # shellcheck source=bin/install.sh
    source "$SCRIPT_DIR/../share/evangelion/bin/install.sh"
elif [[ -d $SCRIPT_DIR/../themes && -f $SCRIPT_DIR/install.sh ]]; then
    # shellcheck source=bin/install.sh
    source "$SCRIPT_DIR/install.sh"
else
    printf 'eva: Installation files are missing. Rerun install.sh from the downloaded Evangelion folder.\n' >&2
    exit 1
fi

theme_name() {
    case $1 in eva01) printf 'EVA-01';; wunder) printf 'Wunder';; eva02) printf 'EVA-02';; ramiel) printf 'Ramiel';; esac
}

normalize_theme() {
    local value=${1,,}
    value=${value//-/}
    case $value in eva01|wunder|eva02|ramiel) printf '%s' "$value";; *) die "Unknown theme: $1. Use 'eva list' to see available themes.";; esac
}

normalize_profile() {
    case ${1,,} in 720|720p) printf '720p';; 1080|1080p) printf '1080p';; 1440|1440p) printf '1440p';; *) die "Unknown profile: $1. Choose 720p, 1080p or 1440p.";; esac
}

usage() {
    cat <<'HELP'
Evangelion theme chooser

Usage:
  sudo eva
  sudo eva set THEME PROFILE [--gfxmode WIDTHxHEIGHT]
  eva list
  sudo eva status
  sudo eva rollback
  sudo eva uninstall

Themes:   eva01, wunder, eva02, ramiel
Profiles: 720p, 1080p, 1440p

Options:
  --gfxmode WIDTHxHEIGHT  Choose one exact firmware mode
  --dry-run              Preview changes without applying them
  --no-apply             Install only the command and catalog with install.sh
  --grub-dir DIRECTORY   Select /boot/grub or /boot/grub2 if both exist
  --root DIRECTORY       Use a staging root instead of the live host
  -h, --help             Show this help

Examples:
  sudo eva set wunder 1080p
  sudo eva set eva01 1440p --gfxmode 2560x1600

No command opens the chooser in an interactive terminal. Rollback restores
one previous Evangelion choice; uninstall restores the prior GRUB appearance.
HELP
}

catalog() {
    local theme profile available
    CATALOG=()
    for theme in "${THEMES[@]}"; do
        available=
        for profile in "${PROFILES[@]}"; do
            if (source_files "$theme" "$profile") >/dev/null 2>&1; then available+=" $profile"; fi
        done
        [[ -z $available ]] || CATALOG["$theme"]=${available# }
    done
}

prompt_choice() {
    local label=$1 default=$2 name=$3 answer index value default_number=1 display
    local -n choices=$name
    printf '\nChoose a %s:\n' "${label,,}"
    for index in "${!choices[@]}"; do
        value=${choices[$index]}
        [[ $value != "$default" ]] || default_number=$((index + 1))
        if [[ $label == Theme ]]; then display=$(theme_name "$value"); else
            display="$value  $(profile_mode "$value")"
            [[ $value != 1440p ]] || display+=' and larger'
        fi
        printf '  %s) %s\n' "$((index + 1))" "$display"
    done
    while true; do
        printf '%s [%s]: ' "$label" "$default_number"
        if ! IFS= read -r answer; then printf '\nCancelled.\n' >&2; exit 130; fi
        # Trim surrounding whitespace without interpreting escape sequences.
        answer=${answer#"${answer%%[![:space:]]*}"}; answer=${answer%"${answer##*[![:space:]]}"}
        if [[ -z $answer ]]; then CHOICE=$default; return; fi
        if [[ $answer =~ ^[1-9]$ ]] && ((answer <= ${#choices[@]})); then CHOICE=${choices[$((answer - 1))]}; return; fi
        answer=${answer,,}; answer=${answer//-/}
        for value in "${choices[@]}"; do
            if [[ $answer == "$value" ]]; then CHOICE=$value; return; fi
        done
        printf 'Choose a number from 1 to %s.\n' "${#choices[@]}"
    done
}

guided() {
    [[ -t 0 && -t 1 ]] || die "The chooser needs an interactive terminal. Use 'eva set THEME PROFILE'."
    catalog
    ((${#CATALOG[@]})) || die 'No validated themes are available. Reinstall a complete Evangelion package.'
    local -a themes=() profiles=()
    local theme default current
    for theme in "${THEMES[@]}"; do [[ ! -v CATALOG[$theme] ]] || themes+=("$theme"); done
    load_state
    current=$(jq -r '.theme // empty' <<< "$STATE_DATA"); default=${themes[0]}
    [[ -z $current || ! -v CATALOG[$current] ]] || default=$current
    printf 'Evangelion theme chooser\n'
    prompt_choice Theme "$default" themes
    THEME=$CHOICE
    read -r -a profiles <<< "${CATALOG[$THEME]}"
    default=${profiles[${#profiles[@]}-1]}; current=$(jq -r '.profile // empty' <<< "$STATE_DATA")
    for theme in "${profiles[@]}"; do [[ $theme != "$current" ]] || default=$current; done
    prompt_choice 'Display profile' "$default" profiles
    PROFILE=$CHOICE
}

status() {
    local path previous
    load_state
    path=$(safe_path "$ROOT" "$MANAGER")
    if [[ -f $path ]]; then printf 'Theme manager: installed\n'; else printf 'Theme manager: running from checkout\n'; fi
    if [[ $STATE_DATA == null ]]; then printf 'No Evangelion theme is currently configured.\n'; return; fi
    printf 'Configured theme: %s\n' "$(theme_name "$(jq -r .theme <<< "$STATE_DATA")")"
    printf 'Display profile: %s\n' "$(jq -r .profile <<< "$STATE_DATA")"
    printf 'Requested graphics mode: %s\n' "$(jq -r .gfxmode <<< "$STATE_DATA")"
    previous=$(jq -c .previous <<< "$STATE_DATA")
    if [[ $previous == null ]]; then printf 'Previous choice: none; uninstall restores the prior GRUB appearance.\n'; else
        printf 'Previous choice: %s, %s, %s\n' "$(theme_name "$(jq -r .theme <<< "$previous")")" "$(jq -r .profile <<< "$previous")" "$(jq -r .gfxmode <<< "$previous")"
    fi
}

eva_main() {
    local command='' backend=0 no_apply=0 named_theme='' named_profile='' arg theme
    local -a positional=()
    declare -gA CATALOG=()
    THEME='' PROFILE=''
    QUIET=1
    while (($#)); do
        arg=$1; shift
        case $arg in
            -h|--help|help) usage; return;;
            --backend) backend=1; QUIET=0;;
            --dry-run) DRY_RUN=1;;
            --quiet) QUIET=1;;
            --no-apply) no_apply=1;;
            --install-manager) DEPLOY=1;;
            --root|--source|--generator|--gfxmode|--theme|--profile|--grub-dir)
                (($#)) || die "$arg requires a value"
                case $arg in
                    --grub-dir) GRUB_DIR_OPTION=$1;;
                    --root) ROOT=$1;; --source) SOURCE=$1;; --generator) GENERATOR=$1;; --gfxmode) MODE=$1;;
                    --theme) [[ -z $named_theme ]] || die 'Supply theme once'; named_theme=$1;;
                    --profile) [[ -z $named_profile ]] || die 'Supply profile once'; named_profile=$1;;
                esac
                shift;;
            --) positional+=("$@"); break;;
            --*=*) set -- "${arg%%=*}" "${arg#*=}" "$@";;
            -*) die "Unknown option: $arg";;
            *) positional+=("$arg");;
        esac
    done
    ((${#positional[@]} <= 3)) || die 'Too many arguments'
    command=${positional[0]:-}; THEME=${positional[1]:-}; PROFILE=${positional[2]:-}
    if [[ -z $command ]]; then
        if [[ ! -t 0 || ! -t 1 ]]; then usage; return; fi
        command=choose
    fi
    case $command in choose|set|list|status|rollback|uninstall|install) ;; setup) ((backend)) || die 'Use install.sh --no-apply';; *) die "Unknown command: $command";; esac
    [[ -z $THEME || -z $named_theme ]] && [[ -z $PROFILE || -z $named_profile ]] || die 'Supply theme and profile once, as positional values or named options.'
    THEME=${THEME:-$named_theme}; PROFILE=${PROFILE:-$named_profile}
    if [[ $command != install && $command != set && ( -n $THEME || -n $PROFILE ) ]]; then die "$command does not take a theme or profile."; fi
    if ((no_apply)); then
        [[ $command == install ]] || die '--no-apply is only for install.sh.'
        [[ -z $THEME && -z $PROFILE && -z $MODE ]] || die '--no-apply cannot be combined with a theme, profile or graphics mode.'
    fi
    if [[ -n $MODE && $command != set && $command != choose && $command != install ]]; then die "$command does not take --gfxmode."; fi
    init_workspace
    case $command in
        list)
            catalog
            for theme in "${THEMES[@]}"; do if [[ -v CATALOG[$theme] ]]; then printf '%-8s %s\n' "$(theme_name "$theme")" "${CATALOG[$theme]}"; fi; done
            ((${#CATALOG[@]})) || printf 'No validated themes are available.\n'
            return;;
        status) status; return;;
        rollback|uninstall|setup) ACTION=$command; run_operation; return;;
    esac
    if [[ $command == install ]] && { ((no_apply)) || [[ -z $THEME && -z $PROFILE && ( ! -t 0 || ! -t 1 ) ]]; }; then
        [[ -z $MODE ]] || die 'Noninteractive installation with --gfxmode requires a theme and profile.'
        ACTION=setup; run_operation
        if ((!DRY_RUN)); then printf '\nEvangelion theme manager is installed. GRUB appearance is unchanged.\nChoose a theme with: sudo eva\n'; fi
        return
    fi
    [[ -z $THEME && -z $PROFILE || -n $THEME && -n $PROFILE ]] || die 'set requires both a theme and a profile, for example: eva set wunder 1080p'
    if [[ -z $THEME ]]; then guided; fi
    THEME=$(normalize_theme "$THEME"); PROFILE=$(normalize_profile "$PROFILE")
    load_state
    # Keep explicit padding when only the theme changes, as in the prior chooser.
    if ((!backend)) && [[ -z $MODE && $(jq -r '.profile // empty' <<< "$STATE_DATA") == "$PROFILE" ]]; then MODE=$(jq -r .gfxmode <<< "$STATE_DATA"); fi
    ACTION=install
    if [[ $command == install ]] && ((!backend)); then DEPLOY=1; fi
    run_operation
    if ((!DRY_RUN && !backend)); then
        printf '\n%s is configured for the next boot.\n' "$(theme_name "$THEME")"
        if ((DEPLOY)); then printf 'Switch themes from any directory with: sudo eva\n'; fi
    fi
}

eva_main "$@"
