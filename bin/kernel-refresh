#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Refresh the installed catalog and boot configuration after the distribution adds or removes a kernel.
set -eu
case ${1:-} in add|remove) ;; *) exit 0;; esac
[[ -f /var/lib/evangelion-grub/state.json && -x /usr/local/bin/eva ]] || exit 0
if ! /usr/local/bin/eva refresh; then
    printf 'eva: refresh failed; the previous GRUB configuration remains active.\n' >&2
fi
