#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Build a checked Fedora type-1 BLS snapshot. Exit 2 requests the native menu.
set -Eeuo pipefail
export LC_ALL=C
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
(($# == 2)) || exit 1
root=$1 output=$2
directory=${root%/}/boot/loader/entries
fallback() { printf 'eva: BLS snapshot: %s\n' "$*" >&2; exit 2; }
[[ -d $directory ]] || exit 2
[[ ! -L $directory && $(realpath -e -- "$directory") == "$directory" ]] || fallback 'entry directory is not a canonical directory'
command_path() {
    command -v "grub-$1" || command -v "grub2-$1"
}
probe=$(command_path probe) || fallback 'grub-probe or grub2-probe is missing'
relpath=$(command_path mkrelpath) || fallback 'grub-mkrelpath or grub2-mkrelpath is missing'
uuid=$("$probe" --target=fs_uuid "$directory") || fallback 'cannot identify the boot filesystem'
path=$("$relpath" "$directory") || fallback 'cannot resolve the GRUB entry path'
[[ $uuid =~ ^[A-Za-z0-9-]+$ && $path =~ ^/[A-Za-z0-9_./@+-]+$ && /${path#/}/ != */../* ]] || fallback 'unsupported boot filesystem UUID or entry path'
stamp=$(stat -c %Y -- "$directory")
# GRUB compares whole-second mtimes. Finish the snapshot in a later second so
# a subsequent kernel addition cannot share the directory's recorded second.
if ((stamp >= $(date +%s))); then sleep 1; fi
((stamp < $(date +%s))) || fallback 'entry directory timestamp is in the future'
shopt -s nullglob
files=("$directory"/*.conf)
((${#files[@]} && ${#files[@]} <= 1000)) || fallback 'expected between 1 and 1000 entry files'
mkdir -p -- "$output/files"
inputs=$(mktemp -d "${output%/*}/bls-inputs-XXXXXXXX")
trap 'rm -rf -- "$inputs"' EXIT
index=0
for file in "${files[@]}"; do
    name=${file##*/}
    [[ -f $file && ! -L $file && $name =~ ^[A-Za-z0-9_+.~:-]+\.conf$ ]] || fallback "unsupported entry file: $name"
    (($(stat -c %s -- "$file") <= 1048576)) || fallback "entry exceeds 1 MiB: $name"
    cp -- "$file" "$inputs/$name"
    printf -v number '%04d' "$((++index))"
    cp -- "$inputs/$name" "$output/files/$number.conf"
done
awk -f "$here/bls-menu.awk" "$inputs"/*.conf > "$output/entries.cfg" || exit 2
checker=$(command_path script-check) || fallback 'grub-script-check or grub2-script-check is missing'
"$checker" "$output/entries.cfg" >/dev/null 2>&1 || fallback 'generated entries failed grub-script-check'
# Detect writes during the snapshot as well as during boot.
[[ $(stat -c %Y -- "$directory") == "$stamp" ]] || fallback 'entry directory changed while reading it; retry refresh'
current=("$directory"/*.conf)
[[ ${files[*]} == "${current[*]}" ]] || fallback 'entry list changed while reading it; retry refresh'
for file in "${files[@]}"; do cmp -s -- "$file" "$inputs/${file##*/}" || fallback "entry changed while reading it: ${file##*/}; retry refresh"; done
printf '%s\n' "$stamp" > "$output/stamp"
printf '0\n' > "$output/unequal"
cat > "$output/guard.cfg" <<EOF
# Verify both the comparison command and the live BLS records before use.
set eva_bls_valid=0
set eva_bls_device=
set eva_bls_cmp_ready=0
insmod cmp
if cmp "\$prefix/themes/evangelion/bls/stamp" "\$prefix/themes/evangelion/bls/stamp"; then
  if cmp "\$prefix/themes/evangelion/bls/stamp" "\$prefix/themes/evangelion/bls/unequal"; then
    set eva_bls_cmp_ready=0
  else
    set eva_bls_cmp_ready=1
  fi
fi
search --no-floppy --fs-uuid --set=eva_bls_device $uuid
set eva_bls_path="(\$eva_bls_device)$path"
if [ -n "\$eva_bls_device" -a "\$eva_bls_cmp_ready" = 1 ]; then
  set eva_bls_valid=1
fi
if [ "\$root" != "\$eva_bls_device" ]; then set eva_bls_valid=0; fi
if [ -n "\$early_initrd" -o -n "\$devicetree" ]; then set eva_bls_valid=0; fi
if [ -n "\$superusers" -o -f "\$prefix/user.cfg" ]; then set eva_bls_valid=0; fi
if [ -n "\$blsdir" -a "\$blsdir" != "$path" -a "\$blsdir" != "${path#/}" ]; then set eva_bls_valid=0; fi
if [ "\$eva_bls_path" -nt "\$prefix/themes/evangelion/bls/stamp" -o "\$eva_bls_path" -ot "\$prefix/themes/evangelion/bls/stamp" ]; then set eva_bls_valid=0; fi
EOF
index=0
for file in "${files[@]}"; do
    printf -v number '%04d' "$((++index))"
    printf 'if cmp "$eva_bls_path/%s" "$prefix/themes/evangelion/bls/files/%s.conf"; then [ 1 = 1 ]; else set eva_bls_valid=0; fi\n' "${file##*/}" "$number" >> "$output/guard.cfg"
done
